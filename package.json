{
  "name": "dsh-voice-tts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Synthèse vocale locale pour DSH : expose `say` (voix Apple) comme service HTTP sur la boucle locale, pour que la page Web puisse lire une réponse à voix haute.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "tools/voices.swift",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "icon.svg",
    "assets/*.wav"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  }
}
